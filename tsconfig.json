{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "paths": {
      "@gg/shared": ["./packages/shared/src/index.ts"],
      "@gg/shared/*": ["./packages/shared/src/*"]
    }
  },
  "include": [
    "scripts/**/*",
    "packages/*/src/**/*",
    "backend/src/**/*",
    "backend/test/**/*",
    "frontend/src/**/*"
  ]
}
